{
  "name": "energy-period-selector-plus",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "A configurable energy period selector for Home Assistant energy dashboards",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "dashboard",
    "custom-cards",
    "energy",
    "period",
    "date",
    "selector"
  ],
  "main": "./dist/energy-period-selector-plus.js",
  "exports": {
    ".": "./dist/energy-period-selector-plus.js",
    "./source": "./src/energy-period-selector-plus.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flixlix/flixlix-cards.git"
  },
  "author": "flixlix",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/flixlix/flixlix-cards/issues"
  },
  "homepage": "https://github.com/flixlix/flixlix-cards#readme",
  "scripts": {
    "build": "vp build",
    "release": "pnpm build && pnpm changeset tag",
    "clean": "rimraf dist node_modules",
    "start": "vp build --watch",
    "dev": "vp build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --coverage && vp test run --config vitest.browser.config.ts --project dom",
    "test:visual": "vp test run --config vitest.browser.config.ts --project visual",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@flixlix-cards/shared": "workspace:*",
    "@mdi/js": "catalog:packages",
    "custom-card-helpers": "catalog:packages",
    "home-assistant-js-websocket": "catalog:packages",
    "lit": "catalog:packages"
  },
  "devDependencies": {
    "@flixlix-cards/bundler": "workspace:*",
    "@flixlix-cards/testing": "workspace:*",
    "@flixlix-cards/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:packages",
    "playwright": "catalog:packages",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vite-plus": "catalog:packages"
  }
}

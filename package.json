{
  "name": "flixlix-cards",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "vp run -r --cache build",
    "dev": "vp run -r --parallel dev",
    "check": "vp check && pnpm check:changesets",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vp run -r --cache typecheck",
    "test": "vp run --cache --filter './packages/**' test",
    "test:visual": "sh scripts/test-visual.sh",
    "test:visual:update": "sh scripts/test-visual.sh --update",
    "clean": "vp run -r clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "vp run -r build && changeset publish",
    "release:tag": "changeset tag",
    "build:cards": "vp run --cache --filter './packages/flixlix-cards/**' build",
    "start:hass": "pnpm build:cards && docker compose -f compose.hass.yaml up",
    "hass:up": "pnpm build:cards && docker compose -f compose.hass.yaml up -d && pnpm hass:bootstrap",
    "hass:bootstrap": "vpx ./e2e/scripts/bootstrap.ts",
    "hass:sync-theme": "vpx ./e2e/scripts/sync-ha-theme.ts",
    "hass:down": "docker compose -f compose.hass.yaml down",
    "hass:logs": "docker compose -f compose.hass.yaml logs -f",
    "hass:reset": "docker compose -f compose.hass.yaml down && git clean -fdX .hass_dev",
    "e2e": "pnpm --filter @flixlix-cards/e2e e2e",
    "e2e:ui": "pnpm --filter @flixlix-cards/e2e e2e:ui",
    "check:changesets": "node packages/tooling/release-notes/check-changesets.js"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:packages",
    "vite-plus": "catalog:packages",
    "@flixlix-cards/release-notes": "workspace:*"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "engines": {
    "node": ">=22.18.0"
  }
}
